{
  "private": true,
  "name": "firestore-devtools",
  "description": "Inspect Firestore gRPC/WebChannel traffic from the browser DevTools, like the Network tab.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "extension dev",
    "start": "extension start",
    "build": "extension build",
    "preview": "extension preview",
    "build:chrome": "extension build --browser chrome",
    "build:firefox": "extension build --browser firefox",
    "build:edge": "extension build --browser edge",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/chrome": "0.2.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "extension": "4.1.5",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
